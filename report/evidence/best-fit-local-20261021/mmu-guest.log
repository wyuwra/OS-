COMMAND -interpreter-exec console "set pagination off"
=thread-group-added,id="i1"
~"Reading symbols from bin/kernel...\n"
(gdb) 
=cmd-param-changed,param="pagination",value="off"
1^done
(gdb) 
COMMAND -target-select remote 127.0.0.1:1234
=thread-group-started,id="i1",pid="1"
=thread-created,id="1",group-id="i1"
~"0x0000000000001000 in ?? ()\n"
*stopped,frame={addr="0x0000000000001000",func="??",args=[],arch="riscv:rv64"},thread-id="1",stopped-threads="all"
2^connected
(gdb) 
COMMAND -interpreter-exec console "tbreak kern_init"
~"Temporary breakpoint 1 at 0xffffffffc02003f4: file kern/init/init.c, line 84.\n"
=breakpoint-created,bkpt={number="1",type="breakpoint",disp="del",enabled="y",addr="0xffffffffc02003f4",func="kern_init",file="kern/init/init.c",fullname="/home/sven1/course-project/os/OS-/lab2_new/kern/init/init.c",line="84",thread-groups=["i1"],times="0",original-location="kern_init"}
3^done
(gdb) 
COMMAND -exec-continue
4^running
*running,thread-id="all"
(gdb) 
COMMAND -gdb-exit
